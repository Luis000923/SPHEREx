# Version control and agent worktrees
.git
.devin-worktrees/
.devin-runs/

# Build outputs (rebuilt inside the image)
**/node_modules
**/dist
**/target

# Tests and fixtures are not needed to build the release artifacts
backend/tests
backend/fixtures

# Docs, contract and ops files are not part of the image.
# scripts/ is excluded except the container entrypoint; cache-bake/ is
# intentionally NOT excluded: the runtime stage bakes it into /data/cache
# (it may be absent — the Dockerfile tolerates that).
docs/
shared/
.github/
scripts/*
!scripts/docker-entrypoint.sh
*.md
Dockerfile
.dockerignore
docker-compose.yml

# Local env / logs (never ship secrets)
.env
*.log
